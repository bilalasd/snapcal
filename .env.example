# Neon Postgres connection string (from console.neon.tech or Vercel Marketplace)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# The passcode you type on the login screen — pick anything
APP_PASSCODE=change-me

# Random secret for signing session cookies — e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-too

# Fitbit app credentials (register a "Personal" app at dev.fitbit.com)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Random secret protecting cron endpoints — Vercel sends it automatically
# when set in project env vars. e.g. `openssl rand -hex 32`
CRON_SECRET=

# Base URL of the deployed app (used for Fitbit OAuth redirect)
APP_BASE_URL=http://localhost:3000
