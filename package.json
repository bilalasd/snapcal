{
  "name": "loggi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "yarn workspace @loggi/api",
    "shared": "yarn workspace @loggi/shared",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "packageManager": "yarn@4.17.1",
  "version": "1.0.0"
}
